{
  "name": "campusfind-backend",
  "version": "1.0.0",
  "description": "Backend API Server for CampusFind",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "test-db": "ts-node src/scripts/test-db-connection.ts",
    "test:auth": "ts-node src/scripts/test-auth.ts",
    "test:items": "ts-node src/scripts/test-items.ts",
    "test:images": "ts-node src/scripts/test-images.ts",
    "test:verification-security": "ts-node src/scripts/test-verification-security.ts",
    "test:claims": "ts-node src/scripts/test-claims.ts",
    "test:matching": "ts-node src/scripts/test-matching.ts",
    "test:admin-matches": "ts-node src/scripts/test-admin-matches.ts",
    "test:handover": "ts-node src/scripts/test-handover.ts"
    ,"test:student-workflow": "ts-node src/scripts/test-student-workflow.ts",
    "test:participant-handover": "ts-node src/scripts/test-participant-handover.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
