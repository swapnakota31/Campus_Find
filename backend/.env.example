# Server Port Configuration
PORT=5000

# Environment Mode
NODE_ENV=development

# PostgreSQL Connection URL
# Replace connection details for your environment
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusfind?schema=public"

# Allowed email domains for student verification (comma-separated if multiple)
ALLOWED_EMAIL_DOMAINS="gecgudlavallerumic.in"

# Frontend Origin URL for CORS configuration
CORS_ORIGIN="http://localhost:3000"

# JWT Secret for Session Cookies
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Email Configuration Mode ("dev" logs only; "smtp" sends real email)
EMAIL_MODE="smtp"
# Microsoft 365 / Outlook SMTP submission settings
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="your-college-mailbox@gecgudlavallerumic.in"
SMTP_PASSWORD="your-mailbox-password-or-app-password"
# Use the same mailbox or an authorized sender address
EMAIL_FROM="your-college-mailbox@gecgudlavallerumic.in"

# Cloudinary Private Image Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_IMAGES_PER_ITEM=5
MAX_IMAGE_SIZE_BYTES=5242880


